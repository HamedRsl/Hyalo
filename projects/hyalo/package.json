{
  "name": "@hyalo/angular",
  "version": "0.4.0",
  "description": "Liquid glass components for Angular. Signals, zoneless, SSR-safe, accessible, RTL-ready.",
  "license": "MIT",
  "author": "HamedRsl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HamedRsl/Hyalo.git"
  },
  "homepage": "https://github.com/HamedRsl/Hyalo#readme",
  "bugs": {
    "url": "https://github.com/HamedRsl/Hyalo/issues"
  },
  "keywords": [
    "angular",
    "ui",
    "components",
    "glass",
    "glassmorphism",
    "liquid-glass",
    "rtl",
    "signals"
  ],
  "peerDependencies": {
    "@angular/aria": "^22.2.0",
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "gsap": "^3.12.0",
    "rxjs": "^7.4.0",
    "chart.js": "^4.6.1",
    "highlight.js": "^11.11.1",
    "jalaali-js": "^1.2.8"
  },
  "peerDependenciesMeta": {
    "jalaali-js": {
      "optional": true
    },
    "gsap": {
      "optional": true
    },
    "chart.js": {
      "optional": true
    },
    "highlight.js": {
      "optional": true
    }
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./styles/hyalo.css": {
      "default": "./styles/hyalo.css"
    },
    "./styles/hyalo-core.css": {
      "default": "./styles/hyalo-core.css"
    },
    "./styles/overlays/*": {
      "default": "./styles/overlays/*"
    },
    "./styles/palettes/*": {
      "default": "./styles/palettes/*"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
