{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "docs": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/docs",
      "sourceRoot": "projects/docs/src",
      "prefix": "docs",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/docs/src/main.ts",
            "tsConfig": "projects/docs/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/docs/public"
              }
            ],
            "styles": [
              "projects/hyalo/styles/hyalo.css",
              "projects/docs/src/styles.css",
              {
                "input": "projects/hyalo/styles/palettes/aurora.css",
                "bundleName": "palette-aurora",
                "inject": false
              },
              {
                "input": "projects/hyalo/styles/palettes/ember.css",
                "bundleName": "palette-ember",
                "inject": false
              },
              {
                "input": "projects/hyalo/styles/palettes/orchid.css",
                "bundleName": "palette-orchid",
                "inject": false
              },
              {
                "input": "projects/hyalo/styles/palettes/ocean.css",
                "bundleName": "palette-ocean",
                "inject": false
              },
              {
                "input": "projects/hyalo/styles/palettes/rose.css",
                "bundleName": "palette-rose",
                "inject": false
              },
              {
                "input": "projects/hyalo/styles/palettes/graphite.css",
                "bundleName": "palette-graphite",
                "inject": false
              }
            ],
            "server": "projects/docs/src/main.server.ts",
            "outputMode": "static"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "600kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "10kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "docs:build:production"
            },
            "development": {
              "buildTarget": "docs:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/docs/**/*.ts", "projects/docs/**/*.html"]
          }
        }
      }
    },
    "hyalo": {
      "projectType": "library",
      "root": "projects/hyalo",
      "sourceRoot": "projects/hyalo",
      "prefix": "hy",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/hyalo/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/hyalo/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/hyalo/tsconfig.spec.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/hyalo/**/*.ts", "projects/hyalo/**/*.html"]
          }
        }
      }
    },
    "size-check": {
      "projectType": "application",
      "root": "projects/size-check",
      "sourceRoot": "projects/size-check/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/size-check/src/main.ts",
            "tsConfig": "projects/size-check/tsconfig.json",
            "index": "projects/size-check/src/index.html",
            "outputPath": "dist/size-check"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "310kB",
                  "maximumError": "330kB"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
