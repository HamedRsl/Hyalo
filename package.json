{
  "name": "hyalo",
  "version": "0.0.0",
  "scripts": {
    "docs:sources": "node tools/sync-phase6-api.mjs && node tools/sync-example-sources.mjs",
    "docs:check-sources": "node tools/check-example-sources.mjs",
    "prestart": "node tools/sync-example-sources.mjs",
    "prebuild": "node tools/sync-example-sources.mjs",
    "ng": "ng",
    "start": "ng serve docs",
    "build": "ng build hyalo && ng build docs",
    "build:lib": "ng build hyalo",
    "build:docs": "node tools/sync-example-sources.mjs && ng build docs",
    "size": "node tools/install-packed.mjs && ng build size-check",
    "test": "node --test tools/sync-example-sources.spec.mjs && ng test hyalo --watch=false && ng test docs --watch=false",
    "lint": "ng lint && node tools/check-logical-css.mjs && node tools/check-prose.mjs && npm run check:architecture",
    "format": "prettier --write .",
    "prepare": "husky",
    "check:architecture": "node tools/check-package-boundaries.mjs",
    "check:api-audit": "node tools/check-api-audit.mjs",
    "check:api-browser": "node --test tools/api-audit-browser.spec.mjs",
    "check:consumer": "node tools/check-packed-consumer.mjs",
    "check:browsers": "node tools/check-browser-matrix.mjs",
    "check:performance": "node tools/check-scene-performance.mjs",
    "check:package": "node tools/check-package-boundaries.mjs --built",
    "docs:api": "node tools/sync-phase6-api.mjs",
    "docs:check-api": "node tools/sync-phase6-api.mjs --check"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/aria": "^22.2.5",
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/list": "^6.1.22",
    "@fullcalendar/luxon3": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-character-count": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@types/jalaali-js": "^1.2.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.12.0",
    "angular-eslint": "22.6.0",
    "axe-core": "^4.14.0",
    "chart.js": "^4.6.1",
    "eslint": "^10.12.0",
    "gsap": "^3.15.0",
    "highlight.js": "^11.12.0",
    "husky": "^9.1.7",
    "jalaali-js": "^2.0.1",
    "jsdom": "^30.0.0",
    "luxon": "^3.7.2",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
